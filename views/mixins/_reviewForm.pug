mixin reviewForm(store)
  form.reviewer(action=`/reviews/${store._id}` method="POST")
    .reviewer__heading
      h3 Leave a review
      p Tell others what made this place worth visiting.

    label.reviewer__label(for="review-text") Your review
    textarea.reviewer__textarea(
      id="review-text"
      name="text"
      rows="5"
      required
      placeholder="What did you try? What stood out?"
    )

    fieldset.reviewer__rating
      legend Your rating
      .reviewer__stars
        each num in [5, 4, 3, 2, 1]
          input(type="radio" required id=`star${num}` name="rating" value=num)
          label(for=`star${num}` title=`${num} out of 5 stars`)
            span.hide #{num} out of 5 stars

    .reviewer__footer
      button.button.button--primary(type="submit") Submit review
