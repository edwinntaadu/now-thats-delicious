mixin review(review)
  - const rating = Math.max(0, Math.min(5, Number(review.rating) || 0))
  article.review
    header.review__header
      .review__author
        img.avatar(
          src=review.author.gravatar
          alt=""
          loading="lazy"
        )
        .review__author-details
          h3= review.author.name
          time.review__time(datetime=review.created)= h.moment(review.created).fromNow()

      .review__stars(aria-label=`Rated ${rating} out of 5 stars`)
        = "★".repeat(rating)
        = "☆".repeat(5 - rating)

    .review__body
      p= review.text
