mixin storeForm(store = {})
  form.form.form--store(
    method="POST"
    action=`/add/${store._id || ''}`
    enctype="multipart/form-data"
  )
    section.form__section(aria-labelledby="store-details-heading")
      .form__section-heading
        h2#store-details-heading Basic details
        p Tell people what this place is and what makes it worth visiting.

      .form__field
        label.form__label(for="name") Name
        input.form__input(
          id="name"
          type="text"
          name="name"
          value=store.name
          autocomplete="organization"
          required
        )

      .form__field
        label.form__label(for="description") Description
        textarea.form__textarea(
          id="description"
          name="description"
          rows="6"
          placeholder="Describe the food, atmosphere, or specialties."
        )= store.description

    section.form__section(aria-labelledby="store-location-heading")
      .form__section-heading
        h2#store-location-heading Location
        p Choose the address from the suggestions so the map coordinates are filled automatically.

      .form__field
        label.form__label(for="address") Address
        input.form__input(
          type="text"
          id="address"
          name="location[address]"
          value=(store.location && store.location.address)
          autocomplete="street-address"
          required
        )

      input(
        type="hidden"
        name="location[type]"
        value="Point"
      )

      .form__grid.form__grid--two
        .form__field
          label.form__label(for="lng") Longitude
          input.form__input(
            type="text"
            inputmode="decimal"
            id="lng"
            name="location[coordinates][0]"
            value=(store.location && store.location.coordinates && store.location.coordinates[0])
            required
          )

        .form__field
          label.form__label(for="lat") Latitude
          input.form__input(
            type="text"
            inputmode="decimal"
            id="lat"
            name="location[coordinates][1]"
            value=(store.location && store.location.coordinates && store.location.coordinates[1])
            required
          )

    section.form__section(aria-labelledby="store-tags-heading")
      .form__section-heading
        h2#store-tags-heading Features
        p Select the details that help people decide whether this store suits them.

      - const choices = ["Wifi", "Open Late", "Family Friendly", "Vegetarian", "Licenced"];
      - const tags = store.tags || [];

      .choice-grid
        each choice in choices
          - const choiceId = `tag-${choice.toLowerCase().replace(/\s+/g, "-")}`;
          .choice
            input.choice__input(
              type="checkbox"
              name="tags"
              id=choiceId
              value=choice
              checked=(tags.includes(choice))
            )
            label.choice__label(for=choiceId)
              span.choice__indicator(aria-hidden="true")
              span= choice

        section.form__section(aria-labelledby="reservation-settings-heading")
          - const reservationSettings = h.reservationSettings(store)
          - const unavailableDatesText = reservationSettings.unavailableDates.map(date => h.moment(date).format("YYYY-MM-DD")).join("\n")

          .form__section-heading
            h2#reservation-settings-heading Reservations
            p Set when this store accepts table requests.

          .form__grid.form__grid--two
            .form__field
              label.form__label(for="accepts-reservations") Accept reservations
              select.form__input(
                id="accepts-reservations"
                name="reservationSettings[acceptsReservations]"
              )
                option(value="true" selected=reservationSettings.acceptsReservations) Yes
                option(value="false" selected=!reservationSettings.acceptsReservations) No

            .form__field
              label.form__label(for="max-party-size") Max party size
              input.form__input(
                id="max-party-size"
                type="number"
                name="reservationSettings[maxPartySize]"
                min="1"
                max="100"
                value=reservationSettings.maxPartySize
                required
              )

          each hours, index in reservationSettings.openingHours
            .form__grid.form__grid--four
              input(
                type="hidden"
                name=`reservationSettings[openingHours][${index}][day]`
                value=hours.day
              ) 

              .form__field
                label.form__label(for=`hours-day-${index}`) Day
                input.form__input(
                  id=`hours-day-${index}`
                  type="text"
                  value=h.daysOfWeek.find(day => day.value === Number(hours.day)).label
                  disabled
                )

              .form__field
                label.form__label(for=`hours-open-${index}`) Opens
                input.form__input(
                  id=`hours-open-${index}`
                  type="time"
                  name=`reservationSettings[openingHours][${index}][open]`
                  value=hours.open
                )

              .form__field
                label.form__label(for=`hours-close-${index}`) Closes
                input.form__input(
                  id=`hours-close-${index}`
                  type="time"
                  name=`reservationSettings[openingHours][${index}][close]`
                  value=hours.close
                )

              .form__field
                label.form__label(for=`hours-closed-${index}`) Status
                select.form__input(
                  id=`hours-closed-${index}`
                  name=`reservationSettings[openingHours][${index}][closed]`
                )
                  option(value="false" selected=!hours.closed) Open
                  option(value="true" selected=hours.closed) Closed

          .form__field
            label.form__label(for="unavailable-dates") Unavailable dates
            textarea.form__textarea(
              id="unavailable-dates"
              name="reservationSettings[unavailableDatesText]"
              rows="4"
              placeholder="2026-12-24\n2026-12-25"
            )= unavailableDatesText

    section.form__section(aria-labelledby="store-photo-heading")
      .form__section-heading
        h2#store-photo-heading Photo
        p Upload a clear landscape image in JPEG, PNG, or GIF format.

      .photo-field
        if store.photo
          img.photo-field__preview(
            src=h.storePhoto(store.photo)
            alt=`Current photo for ${store.name}`
          )

        .form__field
          label.form__label(for="photo") #{store.photo ? "Replace photo" : "Choose photo"}
          input.form__file(
            type="file"
            name="photo"
            id="photo"
            accept="image/gif, image/jpeg, image/png"
          )

    .form__actions.form__actions--sticky
      if store.slug
        a.button.button--secondary(href=`/stores/${store.slug}`) Cancel
      else
        a.button.button--secondary(href="/stores") Cancel
      button.button.button--primary(type="submit") Save store
