doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= `${title} | ${h.siteName}`
    link(rel='stylesheet', href='/dist/style.css')
    link(rel="shortcut icon" type="image/png" href="/images/icons/doughnut.png")
  body
    block header
      header.top
        nav.nav(aria-label="Primary navigation")
          .nav__inner
            .nav__section.nav__section--pages
              a.nav__link.nav__link--logo(href="/" aria-label="Now That's Delicious home")
                != h.icon('logo')
              each item in h.menu
                a.nav__link(href=item.slug, class=(currentPath.startsWith(item.slug) ? 'nav__link--active' : ''))
                  != h.icon(item.icon)
                  span= item.title

            .nav__section.nav__section--search
              .search
                label.search__label(for="site-search") Search stores
                span.search__icon(aria-hidden="true")
                input.search__input(
                  id="site-search"
                  type="search"
                  placeholder="Search stores"
                  name="search"
                  autocomplete="off"
                  aria-label="Search stores"
                )
                .search__results(aria-live="polite")

            .nav__section.nav__section--user
              if user
                a.nav__link.nav__link--user(href="/hearts", class=(currentPath.startsWith('/hearts') ? 'nav__link--active' : ''))
                  != h.icon('heart')
                  span Saved
                  span.heart-count= user.hearts && user.hearts.length
                a.nav__link.nav__link--user(href="/account", class=(currentPath.startsWith('/account') ? 'nav__link--active' : ''))
                  img.avatar(src=user.gravatar + '&d=retro' alt="")
                  span Account
                a.nav__link.nav__link--user(href="/logout")
                  != h.icon('logout')
                  span Logout
              else
                a.nav__link.nav__link--text(href="/register", class=(currentPath.startsWith('/register') ? 'nav__link--active' : '')) Register
                a.nav__link.nav__link--text(href="/login", class=(currentPath.startsWith('/login') ? 'nav__link--active' : '')) Log in

    block messages
        if flashes
            .inner
                .flash-messages
                    - const categories = Object.keys(locals.flashes)
                    each category in categories
                        each message in flashes[category]
                            .flash(class=`flash--${category}`)
                                p.flash__text!= message
                                button.flash__remove(onClick="this.parentElement.remove()") &times;

    .content
      block content
        

    block scripts
    script(src="/dist/App.bundle.js")
    script(async defer src=`https://maps.googleapis.com/maps/api/js?key=${process.env.MAP_KEY}&loading=async&libraries=places&v=beta&callback=initMapAutocomplete`)
